# Base URL of the VIKALP backend API. Optional — defaults to
# http://localhost:8000 (the local `uvicorn` dev server) if unset.
#
# Client-visible: any VITE_* variable ships in the built JS bundle.
# Never put secrets/API keys here.
VITE_API_BASE_URL=http://localhost:8000

# 3D Terrain map (frontend/src/config/mapConfig.ts) — all optional,
# defaults are the free, keyless sources already verified to work
# (OpenFreeMap liberty style + AWS Terrarium elevation tiles). Only
# set these to point at a different style/terrain/location.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_TERRAIN_TILE_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
VITE_MAP_DEFAULT_LAT=30.1
VITE_MAP_DEFAULT_LNG=79.3
VITE_MAP_DEFAULT_ZOOM=11.5
