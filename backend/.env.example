# Optional. Path to the local SQLite database file.
# Defaults to backend/vikalp.db if unset — leave unset for normal local dev.
VIKALP_DATABASE_PATH=

# --- Authentication (Task 35) ---------------------------------------
# REQUIRED to log in or to call any protected /api/* endpoint (every
# endpoint except /health and POST /api/auth/login). There is no
# insecure fallback for any of these four — if unset, authentication
# fails with a clear server error rather than silently accepting
# requests. Never commit real values here; this file holds placeholders
# only.

# Required. Signs and verifies JWTs (HS256). Must be at least 32
# random characters. Generate one locally, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VIKALP_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional. Access-token lifetime in minutes. Defaults to 60 if unset.
VIKALP_JWT_EXPIRES_MINUTES=60

# Required. The single demo officer account for this MVP (no user
# database — see docs/DECISIONS.md Task 35).
VIKALP_OFFICER_USERNAME=demo.officer
VIKALP_OFFICER_PASSWORD=officer123
